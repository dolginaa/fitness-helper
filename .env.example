# Telegram: @BotFather -> create bot -> token
BOT_TOKEN=

# Local: postgres://fitness:fitness@localhost:5432/fitness?sslmode=disable
# Docker Compose bot service sets DATABASE_URL automatically; for `make run` on host use localhost.
DATABASE_URL=postgres://fitness:fitness@localhost:5432/fitness?sslmode=disable

LOG_LEVEL=info

# Time zone for dates in messages and for /workout <date> (IANA name). Empty = system time zone.
TZ=Europe/Moscow

# --- How the bot reaches Telegram -------------------------------------------
# botapi  - HTTP Bot API (default). Needs only BOT_TOKEN.
# mtproto - the protocol of Telegram apps. Needs an application from https://my.telegram.org/apps
#           and can work through an MTProto proxy, like the apps do.
TELEGRAM_TRANSPORT=botapi

# Proxy, optional. The kind depends on the transport:
#   botapi:  socks5://user:pass@host:1080  or  http://user:pass@host:3128
#            (without it HTTPS_PROXY from the environment is used, if set)
#   mtproto: the link apps use - https://t.me/proxy?server=HOST&port=443&secret=...
TELEGRAM_PROXY=

# Only for TELEGRAM_TRANSPORT=mtproto
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Keeps the bot logged in between restarts. Treat it as a secret.
TELEGRAM_SESSION_FILE=data/telegram-session.json

# --- Mini App (web interface inside Telegram), optional ----------------------
# Address to listen on. Empty = the Mini App is off.
WEBAPP_ADDR=
# Public HTTPS address of that listener (Telegram opens Mini Apps only over HTTPS).
# With it set the bot shows the "open app" buttons.
WEBAPP_URL=
# Local development only: open the page in a plain browser as this Telegram user id.
# Never set it on a public server - it switches the authorization off.
WEBAPP_DEV_USER_ID=
